# Copy to .env (git-ignored). Prefix CLAIMS_ for every setting in claims_pipeline/llm/config.py.

# --- a local OpenAI-compatible server (llama.cpp, vLLM, LM Studio, LiteLLM) ---------------
CLAIMS_BACKEND=openai
CLAIMS_OPENAI_BASE_URL=http://liviuspc.tailcf3cc3.ts.net:8081/v1
CLAIMS_MODEL=Qwen3.6-27B-UD-Q4_K_XL.gguf
# CLAIMS_OPENAI_API_KEY=            # only if the server wants a Bearer token
# CLAIMS_OPENAI_TIMEOUT_S=600       # per call
# CLAIMS_OPENAI_DISABLE_THINKING=true

# --- the Claude API instead ---------------------------------------------------------------
# CLAIMS_BACKEND=anthropic
# CLAIMS_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- optional: a different model per component ---------------------------------------------
# CLAIMS_MODEL_READ_DOCUMENT=...
# CLAIMS_MODEL_EXTRACT_FACTS=...
# CLAIMS_MODEL_JUDGE=...
# CLAIMS_MODEL_EXPLAIN=...
# CLAIMS_MODEL_E2E=...
