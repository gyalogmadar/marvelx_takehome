# Copy to .env (git-ignored). Prefix CLAIMS_ for every setting in claims_pipeline/settings.py.

# --- a local OpenAI-compatible server (llama.cpp, vLLM, LM Studio, LiteLLM) ---------------
CLAIMS_BACKEND=openai
CLAIMS_OPENAI_BASE_URL=http://liviuspc.tailcf3cc3.ts.net:8081/v1
CLAIMS_MODEL=Qwen3.6-27B-UD-Q4_K_XL.gguf
# CLAIMS_OPENAI_API_KEY=            # only if the server wants a Bearer token
# CLAIMS_OPENAI_TIMEOUT_S=600       # per call
# CLAIMS_OPENAI_DISABLE_THINKING=true   # false: extract_facts, judge and e2e think (the reasoning is logged)
# CLAIMS_OPENAI_THINKING_READ_DOCUMENT=false   # per component; read_document and explain default to off
# CLAIMS_OPENAI_THINKING_TEMPERATURE=0.6       # thinking calls: also OPENAI_TOP_P, _TOP_K, _MIN_P
# CLAIMS_OPENAI_PRESENCE_PENALTY=0.0           # curbs loops, but can bend verbatim quotes
# CLAIMS_MAX_TOKENS_EXTRACT_FACTS=32000        # per-component budget (default CLAIMS_MAX_TOKENS=16000)

# --- Clef (Cloudflare's decision model) ----------------------------------------------------
# CLAIMS_CLEF_BASE_URL=http://liviuspc.tailcf3cc3.ts.net:8092/v1   # POST .../systemone
# CLAIMS_SCORER=clef                  # Clef scores each document reading and extracted fact; the judge reads the scores
# CLAIMS_JUDGE_BACKEND=clef            # Clef answers every judged check (decomposed strategy)
# CLAIMS_CLEF_MIN_CONFIDENCE=0.6       # a Clef answer below this probability is UNKNOWN

# --- the Claude API instead ---------------------------------------------------------------
# CLAIMS_BACKEND=anthropic
# CLAIMS_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- optional: a different model per component ---------------------------------------------
# CLAIMS_MODEL_READ_DOCUMENT=...
# CLAIMS_MODEL_EXTRACT_FACTS=...
# CLAIMS_MODEL_JUDGE=...
# CLAIMS_MODEL_EXPLAIN=...
# CLAIMS_MODEL_E2E=...

# --- the store ---------------------------------------------------------------------------------
# CLAIMS_DATABASE_URL=sqlite:///data/pipeline.db   # claims, runs, the proof chain, every model call
